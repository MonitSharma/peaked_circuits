{
  "$defs": {
    "BackendDescriptor": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "default": true,
          "title": "Available",
          "type": "boolean"
        },
        "credentials_detected": {
          "default": false,
          "title": "Credentials Detected",
          "type": "boolean"
        },
        "device_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Name"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "sdk_versions": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Sdk Versions",
          "type": "object"
        },
        "target_type": {
          "enum": [
            "local",
            "emulator",
            "syntax_checker",
            "physical",
            "unknown"
          ],
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "target_type"
      ],
      "title": "BackendDescriptor",
      "type": "object"
    },
    "ValidationResult": {
      "additionalProperties": false,
      "properties": {
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "predicates": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Predicates",
          "type": "object"
        }
      },
      "required": [
        "passed",
        "predicates"
      ],
      "title": "ValidationResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "architecture": {
      "title": "Architecture",
      "type": "string"
    },
    "backend": {
      "$ref": "#/$defs/BackendDescriptor"
    },
    "compiled": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compiled"
    },
    "configuration": {
      "additionalProperties": true,
      "title": "Configuration",
      "type": "object"
    },
    "configuration_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Configuration Hash"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "end_timestamp": {
      "format": "date-time",
      "title": "End Timestamp",
      "type": "string"
    },
    "failure": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure"
    },
    "git_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Commit"
    },
    "input_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Hashes",
      "type": "object"
    },
    "operating_system": {
      "title": "Operating System",
      "type": "string"
    },
    "original": {
      "additionalProperties": true,
      "title": "Original",
      "type": "object"
    },
    "overhead": {
      "additionalProperties": true,
      "title": "Overhead",
      "type": "object"
    },
    "package_versions": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Package Versions",
      "type": "object"
    },
    "python_version": {
      "title": "Python Version",
      "type": "string"
    },
    "random_seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Random Seed"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "start_timestamp": {
      "format": "date-time",
      "title": "Start Timestamp",
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "blocked",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValidationResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "wall_clock_seconds": {
      "title": "Wall Clock Seconds",
      "type": "number"
    }
  },
  "required": [
    "status",
    "backend",
    "original",
    "start_timestamp",
    "end_timestamp",
    "wall_clock_seconds",
    "configuration"
  ],
  "title": "CompilationReport",
  "type": "object"
}
