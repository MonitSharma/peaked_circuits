{
  "$defs": {
    "MappingValidationCase": {
      "additionalProperties": false,
      "properties": {
        "canonical_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Output"
        },
        "case_name": {
          "title": "Case Name",
          "type": "string"
        },
        "compiled_circuit_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compiled Circuit Hash"
        },
        "mapping_correct": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapping Correct"
        },
        "prepared_circuit_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prepared Circuit Hash"
        },
        "prepared_logical_string": {
          "title": "Prepared Logical String",
          "type": "string"
        },
        "raw_provider_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Provider Output"
        },
        "status": {
          "default": "prepared",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "case_name",
        "prepared_logical_string"
      ],
      "title": "MappingValidationCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "architecture": {
      "title": "Architecture",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/MappingValidationCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "configuration_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Configuration Hash"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "type": "string"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "git_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Commit"
    },
    "git_dirty": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Dirty"
    },
    "input_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Hashes",
      "type": "object"
    },
    "mode": {
      "title": "Mode",
      "type": "string"
    },
    "operating_system": {
      "title": "Operating System",
      "type": "string"
    },
    "package_versions": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Package Versions",
      "type": "object"
    },
    "passed_cases": {
      "default": 0,
      "title": "Passed Cases",
      "type": "integer"
    },
    "python_version": {
      "title": "Python Version",
      "type": "string"
    },
    "random_seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Random Seed"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "incomplete",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "target": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target"
    },
    "total_cases": {
      "default": 0,
      "title": "Total Cases",
      "type": "integer"
    }
  },
  "required": [
    "status",
    "mode",
    "cases"
  ],
  "title": "MappingValidationReport",
  "type": "object"
}
