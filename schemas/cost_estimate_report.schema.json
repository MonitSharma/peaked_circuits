{
  "$defs": {
    "CostEstimateItem": {
      "additionalProperties": false,
      "properties": {
        "estimate_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate Source"
        },
        "estimated_hqcs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Hqcs"
        },
        "shots": {
          "title": "Shots",
          "type": "integer"
        }
      },
      "required": [
        "shots"
      ],
      "title": "CostEstimateItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "architecture": {
      "title": "Architecture",
      "type": "string"
    },
    "configuration_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Configuration Hash"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "estimates": {
      "items": {
        "$ref": "#/$defs/CostEstimateItem"
      },
      "title": "Estimates",
      "type": "array"
    },
    "git_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Commit"
    },
    "git_dirty": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Dirty"
    },
    "input_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Hashes",
      "type": "object"
    },
    "manual_action_required": {
      "default": false,
      "title": "Manual Action Required",
      "type": "boolean"
    },
    "operating_system": {
      "title": "Operating System",
      "type": "string"
    },
    "package_versions": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Package Versions",
      "type": "object"
    },
    "provenance": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provenance"
    },
    "python_version": {
      "title": "Python Version",
      "type": "string"
    },
    "random_seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Random Seed"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sdk_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sdk Version"
    },
    "status": {
      "enum": [
        "supported",
        "unsupported",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "target": {
      "title": "Target",
      "type": "string"
    }
  },
  "required": [
    "status",
    "target",
    "estimates"
  ],
  "title": "CostEstimateReport",
  "type": "object"
}
