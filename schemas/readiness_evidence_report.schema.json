{
  "$defs": {
    "ReadinessEvidence": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "title": "Check",
          "type": "string"
        },
        "details": {
          "title": "Details",
          "type": "string"
        },
        "evidence_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Hash"
        },
        "evidence_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Path"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "check",
        "passed",
        "details"
      ],
      "title": "ReadinessEvidence",
      "type": "object"
    },
    "ReadinessState": {
      "enum": [
        "NOT_READY",
        "READY_FOR_OFFLINE_ANALYSIS",
        "READY_FOR_COMPILE_ONLY",
        "READY_FOR_QIR_EXPORT",
        "READY_FOR_SYNTAX_CHECK",
        "READY_FOR_EMULATOR_MAPPING_VALIDATION"
      ],
      "title": "ReadinessState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "architecture": {
      "title": "Architecture",
      "type": "string"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "configuration_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Configuration Hash"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/ReadinessEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "git_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Commit"
    },
    "git_dirty": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Dirty"
    },
    "input_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Hashes",
      "type": "object"
    },
    "operating_system": {
      "title": "Operating System",
      "type": "string"
    },
    "package_versions": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Package Versions",
      "type": "object"
    },
    "python_version": {
      "title": "Python Version",
      "type": "string"
    },
    "random_seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Random Seed"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ReadinessState"
    }
  },
  "required": [
    "state",
    "evidence",
    "blockers"
  ],
  "title": "ReadinessEvidenceReport",
  "type": "object"
}
