+def build_handoff_mapping(qasm_path, circuit, mpo):
+    """Build the mandatory mapping contract for a saved handoff."""
+    metadata = getattr(mpo, "_p9_mapping_metadata", None)
+    if not isinstance(metadata, dict):
+        raise ValueError("solver did not attach handoff mapping metadata")
+    required = (
+        "factor_site_to_original_logical",
+        "original_logical_to_factor_site",
+        "routing_permutation",
+        "qasm_q0_first_mapping",
+        "portal_output_convention",
+    )
+    if any(metadata.get(key) is None for key in required):
+        raise ValueError("handoff mapping metadata is incomplete")
+    interface = dict(metadata)
+    interface.update({
+        "schema_version": "p9solver.factor-interface.v2",
+        "qubit_count": circuit.num_qubits,
+        "qasm_filename": qasm_path.name,
+        "qasm_sha256": hashlib.sha256(qasm_path.read_bytes()).hexdigest(),
+        "mpo_site_order": list(range(circuit.num_qubits)),
+        "input_frame": list(range(circuit.num_qubits)),
+        "virtual_tail_frames": getattr(mpo, "_p9_tail_virtual_frames", None),
+    })
+    return interface


